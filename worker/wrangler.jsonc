{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "apple-calendar",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "../_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/bundle.ics",
      "/apple-calendar-ics",
      "/apple-calendar-ics/*"
    ]
  },
  "routes": [
    {
      "pattern": "apple-calendar.lili.uno",
      "custom_domain": true
    }
  ]
}
